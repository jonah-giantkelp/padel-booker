# Required: 2captcha API key for the Cloudflare Turnstile gate.
TWO_CAPTCHA_API_KEY=

# What time (Europe/London) the 7-days-ahead day is released. TBC — the site
# doesn't publish it; measure with: npm run cli:probe-release -- --date <+8d> --once
RELEASE_TIME=00:00

# PORT=8080
# BOOKING_WINDOW_DAYS=7
# WARMUP_MINUTES=2          # start this many minutes before RELEASE_TIME
# POLL_SECONDS=10           # reload cadence while waiting for the day to open
# MAX_WAIT_MINUTES=60       # give up if the day still hasn't opened
# PROBE_POLL_MINUTES=5      # release-time probe reload cadence
# PROBE_MAX_HOURS=24        # release-time probe give-up deadline
# DATA_DIR=./data           # jobs.json, Chrome profile, artifacts
# HEADLESS=false            # watch the browser locally
# On macOS, point at installed Chrome (the bundled download can arrive broken):
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
